# Datos del servidor
AC_SUPPLY_NAME=AC0
SUPPLY_PATH=/sys/class/power_supply
CHECK_INTERVAL=5 # 5 segundos
LATITUDE=0.0
LONGITUDE=0.0
FLUCTUATION_NOTIFY_COOLDOWN_SECONDS=600 # 10 minutos

# API
API_HOST="127.0.0.1"
API_PORT=8095

# NTFY
NTFY_URL=https://nty-instance.domain
NTFY_TOPIC="power_monitor"

# Email
MAIL_HOST="smtp.google.com"
MAIL_PORT=587
MAIL_USERNAME="yourmail@gmail.com"
MAIL_PASSWORD="your-email-password"
MAIL_USE_TLS=True
MAIL_USE_SSL=False
